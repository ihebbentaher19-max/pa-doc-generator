# URL de base de l'API backend (ASP.NET Core Web API)
VITE_API_BASE_URL=http://localhost:5080/api
# Application Microsoft Entra ID de type "Single-page application" (SPA).
# L'URL de redirection doit inclure l'origine Vite, par exemple http://localhost:5173.
VITE_ENTRA_CLIENT_ID=
VITE_ENTRA_TENANT_ID=organizations
# Facultatif : par défaut, l'origine de l'application est utilisée.
# VITE_ENTRA_REDIRECT_URI=http://localhost:5173
