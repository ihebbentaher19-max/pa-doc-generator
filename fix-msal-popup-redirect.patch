diff --git a/frontend/public/auth/popup.html b/frontend/public/auth/popup.html
new file mode 100644
index 0000000..0ba4f41
--- /dev/null
+++ b/frontend/public/auth/popup.html
@@ -0,0 +1,25 @@
+<!DOCTYPE html>
+<html lang="fr">
+  <head>
+    <meta charset="UTF-8" />
+    <title>Connexion Microsoft…</title>
+  </head>
+  <body>
+    <!--
+      Cette page est volontairement vide et ne charge pas le bundle React.
+
+      Rôle : c'est l'URI de redirection utilisée UNIQUEMENT par les popups
+      MSAL (loginPopup / acquireTokenPopup). Microsoft Entra ID redirige le
+      popup ici avec le code d'autorisation dans le fragment d'URL (#code=...).
+
+      MSAL, depuis la fenêtre principale qui a ouvert le popup, surveille
+      l'URL de cette fenêtre (même origine) et récupère lui-même ce code pour
+      fermer le popup. Si cette page chargeait l'application complète
+      (comme c'était le cas quand l'URI de redirection pointait vers "/"),
+      le bootstrap React s'exécutait à l'intérieur du popup, créait sa propre
+      instance MSAL et consommait/effaçait le code avant que la fenêtre
+      principale ait pu le lire : le popup restait alors bloqué sur une page
+      blanche, ou affichait l'application elle-même au lieu de se fermer.
+    -->
+  </body>
+</html>
