\ No newline at end of file
+};
+
+/**
+ * URI de redirection utilisée UNIQUEMENT pour les flux popup (loginPopup /
+ * acquireTokenPopup). Elle pointe vers une page statique vide
+ * (frontend/public/auth/popup.html) plutôt que vers la racine de l'application.
+ *
+ * Pourquoi : avec l'URI de redirection par défaut (racine "/"), Entra ID
+ * redirige le popup vers l'application complète. Le bootstrap React s'exécute
+ * alors À L'INTÉRIEUR du popup, crée sa propre instance MSAL et consomme le
+ * code d'autorisation avant que la fenêtre principale (celle qui a ouvert le
+ * popup) ait pu le lire elle-même. Résultat : le popup reste bloqué sur une
+ * page blanche avec "#code=..." dans l'URL, ou affiche l'application elle-même
+ * au lieu de se fermer. Une page vide élimine cette course entre les deux
+ * instances MSAL.
+ *
+ * Cette URI doit être ajoutée aux "Redirect URIs" de type
+ * "Single-page application" de l'App Registration Entra ID, en plus de
+ * l'origine de l'application.
+ */
+export const popupRedirectUri =
+  import.meta.env.VITE_ENTRA_POPUP_REDIRECT_URI ||
+  `${window.location.origin}/auth/popup.html`;
\ No newline at end of file
